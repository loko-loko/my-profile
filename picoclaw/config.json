{
	"version": 3,
	"agents": {
		"defaults": {
			"workspace": "~/.picoclaw/workspaces/assistant",
			"restrict_to_workspace": true,
			"model_name": "claude-sonnet-4.6",
			"max_tokens": 8192,
			"context_window": 131072,
			"temperature": 0.7,
			"max_tool_iterations": 20,
			"max_llm_retries": 2,
			"llm_retry_backoff_secs": 2
		},
		"list": [
			{
				"id": "assistant",
				"default": true,
				"name": "Assistant",
				"workspace": "~/.picoclaw/workspaces/assistant",
				"model": "claude-sonnet-4.6"
			},
			{
				"id": "african-linguist",
				"name": "African Linguist",
				"workspace": "~/.picoclaw/workspaces/african-linguist",
				"model": "claude-sonnet-4.6"
			}
		],
		"dispatch": {
			"rules": [
				{
					"name": "linguist by telegram sender",
					"agent": "african-linguist",
					"when": {
						"channel": "telegram",
						"sender": "YOUR_LINGUIST_USER_ID"
					},
					"session_dimensions": ["chat", "sender"]
				}
			]
		}
	},
	"model_list": [
		{
			"model_name": "claude-sonnet-4.6",
			"model": "anthropic/claude-sonnet-4.6",
			"api_base": "https://api.anthropic.com/v1",
			"api_keys": ["YOUR_ANTHROPIC_API_KEY"],
			"thinking_level": "high"
		},
		{
			"model_name": "deepseek",
			"model": "deepseek/deepseek-chat",
			"api_keys": ["YOUR_DEEPSEEK_API_KEY"]
		}
	],
	"channel_list": {
		"telegram": {
			"enabled": true,
			"type": "telegram",
			"allow_from": [],
			"reasoning_channel_id": "",
			"settings": {
				"token": "YOUR_TELEGRAM_BOT_TOKEN",
				"base_url": "",
				"proxy": "",
				"use_markdown_v2": false,
				"streaming": {
					"enabled": true
				}
			}
		}
	},
	"tools": {
		"web": {
			"enabled": true,
			"prefer_native": true,
			"format": "plaintext",
			"provider": "auto",
			"duckduckgo": {
				"enabled": true,
				"max_results": 5
			}
		},
		"exec": {
			"enabled": true,
			"enable_deny_patterns": true
		},
		"message": {
			"enabled": true
		},
		"read_file": {
			"enabled": true,
			"mode": "bytes"
		},
		"write_file": {
			"enabled": true
		},
		"list_dir": {
			"enabled": true
		},
		"append_file": {
			"enabled": true
		},
		"edit_file": {
			"enabled": true
		},
		"web_fetch": {
			"enabled": true
		},
		"subagent": {
			"enabled": true
		}
	},
	"heartbeat": {
		"enabled": false,
		"interval": 30
	},
	"devices": {
		"enabled": false,
		"monitor_usb": true
	},
	"voice": {
		"model_name": "",
		"echo_transcription": false
	},
	"gateway": {
		"host": "127.0.0.1",
		"port": 18790,
		"hot_reload": false,
		"log_level": "info"
	}
}